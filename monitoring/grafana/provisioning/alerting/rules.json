{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "keepgo-health",
      "folder": "KeepGo",
      "interval": "30s",
      "rules": [
        {
          "uid": "keepgo-service-down",
          "title": "KeepGo internal service unhealthy",
          "condition": "B",
          "for": "3m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "severity": "warning",
            "source": "grafana"
          },
          "annotations": {
            "summary": "Internal HTTP health probe failed for 3 minutes. Check the service and its dependencies."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "keepgo-prometheus",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "keepgo-prometheus"
                },
                "expr": "probe_success{job=\"service-health\"}",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "keepgo-scrape-down",
          "title": "KeepGo metrics collection unavailable",
          "condition": "B",
          "for": "3m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "severity": "warning",
            "source": "grafana"
          },
          "annotations": {
            "summary": "A scrape target failed for 3 minutes, or Prometheus returned no data. Check monitoring first."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "keepgo-prometheus",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "keepgo-prometheus"
                },
                "expr": "up",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
